---
config:
  layout: elk
  elk:
    mergeEdges: true
    nodePlacementStrategy: SIMPLE
---
flowchart TB

    %% ===== INPUT LAYER =====
    subgraph INPUT["Input"]
        direction LR
        I1["Droplet size\ndistribution\n(μm, cumulative\nvolume fraction)"]
        I2["Atmospheric\nconditions\n(T, P, RH)"]
        I3["Wind velocity\nprofile\n(speed & temp\nat heights)"]
        I4["Nozzle\nparameters\n(height, pressure,\nangle)"]
        I5["Solution\nproperties\n(ρW, ρS, xs0)"]
        I6["Field geometry\n(depth, width,\nspacing, IAR)"]
    end

    %% ===== DERIVED PROPERTIES =====
    subgraph DERIVED["Derived Properties"]
        direction LR
        P1["Atmospheric\nproperties\n(ρA, μA, Twb, ΔTwb)"]
        P2["Wind profile\nfitting\n(Uf, z0, ψψψ)"]
        P3["DSD curve fitting\nBi-modal normal\n(μ1, σ1, μ2, σ2, w1)"]
        P4["Nozzle exit velocity\nBernoulli → 11\nstreamline vectors"]
    end

    %% ===== TRANSPORT =====
    subgraph TRANSPORT["Droplet Transport — 6-DOF ODE (CVODE)"]
        direction LR
        T1["Gravity &\nbuoyancy"]
        T2["Aerodynamic drag\nClift & Gauvin"]
        T3["Droplet evaporation\nRanz–Marshall"]
        T4["Wind interaction\nLog-law profile"]
    end

    %% ===== DEPOSITION =====
    subgraph DEPOSITION["Deposition Calculation"]
        direction LR
        D1["Drift distance\nmatrix\n(streamline × size)"]
        D2["Spray volume\ndistribution\n(SVP per class)"]
        D3["Plume spreading\n(ψψψ crosswind)"]
        D4["Spatial integration\nConcentration matrix\n→ % IAR"]
    end

    %% ===== OUTPUT =====
    subgraph OUTPUT["Output"]
        direction LR
        O1["Ground deposition\n% IAR vs distance"]
        O2["Vertical drift profile\n% IAR vs height"]
        O3["Deposition time\n(seconds per droplet)"]
    end

    %% ===== CONNECTIONS =====
    I1 --> P3
    I2 --> P1
    I3 --> P2
    I4 --> P4
    I5 --> P4
    I5 --> TRANSPORT

    P1 --> TRANSPORT
    P2 --> TRANSPORT
    P2 --> D3
    P3 --> D2
    P4 --> TRANSPORT

    I6 --> DEPOSITION

    TRANSPORT --> D1
    TRANSPORT --> O3
    D1 --> D4
    D2 --> D4
    D3 --> D4

    D4 --> O1
    D4 --> O2

    %% ===== STYLING =====
    style INPUT fill:#f5f5f5,stroke:#333,stroke-width:2px
    style DERIVED fill:#e8f4f8,stroke:#5ba4b5,stroke-width:2px
    style TRANSPORT fill:#fff3e0,stroke:#d68f00,stroke-width:2px
    style DEPOSITION fill:#e8f5e9,stroke:#4caf50,stroke-width:2px
    style OUTPUT fill:#f5f5f5,stroke:#333,stroke-width:2px
